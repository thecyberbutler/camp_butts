# Non-secret settings only. Never place credential values here.
APP_DOMAIN=
DJANGO_ALLOWED_HOSTS=
APP_TIME_ZONE=America/New_York
# Presentation label only; development/test keep all production security controls.
APP_ENVIRONMENT=production
SECRETS_DIR=./.secrets
# Set to the dedicated non-root deployment UID that owns the secret files.
APP_UID=10001
APP_GID=10001
