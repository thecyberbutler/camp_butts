{
    admin off
    http_port 8080
    https_port 8443
    log default {
        exclude http.log.access http.log.error
    }
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            write 30s
            idle 60s
        }
    }
}
{$APP_DOMAIN} {
    request_body {
        max_size 64KB
    }
    handle /static/* {
        root * /srv
        file_server
        header X-Content-Type-Options nosniff
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            header_up -Forwarded
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }
}
