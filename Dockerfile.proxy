FROM traefik:v3.7.20@sha256:8301d6f60957a422f98918aacf2b01482abde3e74ead3719aabdb7c64045fe28
ARG APP_UID=10001
ARG APP_GID=10001
RUN test ${APP_UID} -gt 0 && test ${APP_GID} -gt 0 \
    && mkdir -p /data && chown ${APP_UID}:${APP_GID} /data && chmod 700 /data
COPY infra/traefik /etc/traefik
RUN chmod 755 /etc/traefik/entrypoint.sh
USER ${APP_UID}:${APP_GID}
ENTRYPOINT ["/etc/traefik/entrypoint.sh"]
